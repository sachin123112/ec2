# Copy to .env for local Docker development. Never commit .env.
POSTGRES_DB=backend_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Docker uses the service hostname; host Maven runs should override DB_URL with localhost.
DB_URL=jdbc:postgresql://postgres:5432/backend_platform
DB_USERNAME=postgres
DB_PASSWORD=postgres

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme
CACHE_TYPE=none
CACHE_DEFAULT_TTL=PT60S

JWT_SECRET=dev-secret-32-byte-key-1234567890
JWT_EXPIRATION_MS=900000

DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=3000
DB_POOL_VALIDATION_TIMEOUT_MS=1000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000
DB_POOL_LEAK_DETECTION_MS=0
JPA_DDL_AUTO=validate
JPA_BATCH_SIZE=50

ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URI=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
GOOGLE_DRIVE_CREDENTIALS_FILE=
GOOGLE_DRIVE_FOLDER_ID=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
SERVER_PORT=8080
USER_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8083
UPLOAD_DIRECTORY=uploads
BACKUP_DIRECTORY=backups
PG_DUMP_PATH=pg_dump
BACKUP_CRON=0 0 2 * * *
