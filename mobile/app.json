{
  "expo": {
    "name": "PawMart",
    "slug": "pawmart-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android", "web"],
    "sdkVersion": "50.0.0",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.pawmart.mobile",
      "supportsTablet": false,
      "buildNumber": "1"
    },
    "android": {
      "package": "com.pawmart.mobile",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "DETECT_SCREEN_CAPTURE"
      ]
    }
  }
}
